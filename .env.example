# PostgreSQL connection string.
# With the included docker-compose.yml:
DATABASE_URL="postgresql://pop:pop@localhost:5432/pop"

# The organizer password used at /login. Grants full admin access.
ADMIN_PASSWORD="change-me"

# Optional. A second password for the read-only player demo tier at /login.
# Players land on /player with links to the live scoreboard and pay page.
PLAYER_PASSWORD="change-me-too"

# At least 32 characters. Used to sign the session cookie.
SESSION_SECRET="change-me-to-a-random-32-plus-character-string"
